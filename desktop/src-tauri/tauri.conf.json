{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cypy Manga Translator",
  "version": "0.1.0",
  "identifier": "com.cypy.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cypy Manga Translator",
        "width": 1000,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: http://asset.localhost; img-src 'self' data: blob: asset: http://asset.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/*",
          "C:/**",
          "D:/**",
          "E:/**",
          "F:/**",
          "$HOME/**",
          "$APPDATA/**",
          "$DOWNLOAD/**",
          "$PICTURES/**",
          "$DESKTOP/**",
          "$DOCUMENTS/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "cypy_engine"
    ]
  }
}
